PORT=2026
# waitress listens on loopback only (the tunnel connector); 0.0.0.0 reopens LAN http
HOST=127.0.0.1
# first-run bootstrap admin account (ignored once the users table exists)
APP_USER=admin
APP_PASSWORD=change-me
SECRET_KEY=replace-with-64-hex-chars
DB_PATH=/opt/denba/denba.db
# nightly snapshots land here (default: <dir of DB_PATH>/backups)
BACKUP_DIR=/opt/denba/backups
# passkey (WebAuthn) login — must match the hostname the app is served from
RP_ID=denba.hydr0negnetwork.de
ORIGIN=https://denba.hydr0negnetwork.de
